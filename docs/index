  </form>
</aside>
<div id="done" role="dialog" aria-live="polite"><div><div class="big">🎉</div><h2>Предзаказ принят!</h2><p id="dm" style="color:var(--mute)"></p><button class="btn" id="ok">Отлично</button></div></div>

<script>
const P=[
 {n:'Мишки Гамми',e:'🐻',c:'Мишки',w:'200 г',p:290,b:'Хит',g:'#ff9db8,#ffd0a0'},
 {n:'Малинки',e:'🍓',c:'Ягодные',w:'200 г',p:310,b:'',g:'#ff8aa5,#ffc4d2'},
 {n:'Сердечки в сахаре',e:'💗',c:'Сердечки',w:'200 г',p:320,b:'Новинка',g:'#ff7fa8,#ffd3e2'},
 {n:'Апельсиновые дольки',e:'🍊',c:'Цитрусовые',w:'250 г',p:270,b:'',g:'#ffc46b,#ffe3a8'},
 {n:'Лимонные дольки',e:'🍋',c:'Цитрусовые',w:'250 г',p:270,b:'',g:'#ffe66b,#fff3b0'},
 {n:'Ежевика',e:'🫐',c:'Ягодные',w:'200 г',p:330,b:'',g:'#9a7bff,#d0c2ff'},
 {n:'Яблочные листики',e:'🍏',c:'Ягодные',w:'200 г',p:260,b:'',g:'#8fe08a,#d3f5c8'},
 {n:'Мишки ассорти',e:'🧸',c:'Мишки',w:'400 г',p:520,b:'Выгодно',g:'#ffb3c8,#ffe2a8'}
];
const $=s=>document.querySelector(s);
let cart={},cat='Все';
try{cart=JSON.parse(localStorage.getItem('su-cart')||'{}')}catch(e){}
const fmt=n=>n.toLocaleString('ru-RU')+' ₽';

const cats=['Все',...new Set(P.map(p=>p.c))];
$('#tabs').innerHTML=cats.map(c=>`<button class="tab${c==='Все'?' on':''}">${c}</button>`).join('');
$('#grid').innerHTML=P.map((p,i)=>`<article class="card rv" data-c="${p.c}">
 <div class="pic" style="background:linear-gradient(135deg,${p.g})">${p.e}</div>
 ${p.b?`<span class="badge">${p.b}</span>`:''}<h3>${p.n}</h3><small>${p.c} · ${p.w}</small>
 <div class="row"><span class="price">${fmt(p.p)}</span><button class="add" data-i="${i}">В предзаказ</button></div></article>`).join('');

$('#tabs').onclick=e=>{const t=e.target.closest('.tab');if(!t)return;
 document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('on',x===t));cat=t.textContent;
 document.querySelectorAll('.card').forEach((c,i)=>{const ok=cat==='Все'||c.dataset.c===cat;c.classList.toggle('hide',!ok);c.classList.remove('show');
  if(ok){c.classList.add('in');void c.offsetWidth;c.style.animationDelay=i*50+'ms';c.classList.add('show')}})};

function save(){try{localStorage.setItem('su-cart',JSON.stringify(cart))}catch(e){}}
function render(){
 const ids=Object.keys(cart).filter(i=>cart[i]>0);let n=0,s=0;
 $('#items').innerHTML=ids.length?ids.map(i=>{const p=P[i],q=cart[i];n+=q;s+=q*p.p;
  return `<div class="it"><em>${p.e}</em><div>${p.n}<small>${fmt(p.p)} · ${p.w}</small></div><div class="q"><button data-m="${i}" aria-label="Меньше">−</button><b>${q}</b><button data-p="${i}" aria-label="Больше">+</button></div></div>`}).join('')
  :'<div class="empty">🍬<br>Пока пусто. Добавьте мармеладки из каталога.</div>';
 $('#sum').textContent=fmt(s);const c=$('#cnt');c.textContent=n;c.classList.toggle('on',n>0);save();
}
$('#items').onclick=e=>{const m=e.target.dataset.m,p=e.target.dataset.p;
 if(m!==undefined)cart[m]=Math.max(0,cart[m]-1);if(p!==undefined)cart[p]++;render()};

$('#grid').onclick=e=>{const b=e.target.closest('.add');if(!b)return;const i=b.dataset.i;
 cart[i]=(cart[i]||0)+1;render();
 const f=document.createElement('span');f.className='fly';f.textContent=P[i].e;const r=b.getBoundingClientRect(),t=$('#bag').getBoundingClientRect();
 f.style.left=r.left+r.width/2+'px';f.style.top=r.top+'px';document.body.append(f);
 requestAnimationFrame(()=>{f.style.transform=`translate(${t.left-r.left}px,${t.top-r.top}px) scale(.3) rotate(360deg)`;f.style.opacity='.4'});
 setTimeout(()=>{f.remove();const bg=$('#bag');bg.animate([{transform:'scale(1)'},{transform:'scale(1.3) rotate(-10deg)'},{transform:'scale(1)'}],{duration:350})},700);
 b.textContent='Добавлено ✓';setTimeout(()=>b.textContent='В предзаказ',1100)};

const open=v=>{$('#dr').classList.toggle('on',v);$('#ov').classList.toggle('on',v)};
$('#bag').onclick=()=>open(true);$('#cl').onclick=$('#ov').onclick=()=>open(false);
document.addEventListener('keydown',e=>{if(e.key==='Escape'){open(false);$('#done').classList.remove('on')}});
$('#tl').onclick=()=>open(false);
const d=new Date();d.setDate(d.getDate()+2);$('#dt').min=d.toISOString().slice(0,10);

$('#f').onsubmit=e=>{e.preventDefault();
 const nm=$('#nm'),ph=$('#ph'),n=Object.values(cart).reduce((a,b)=>a+b,0);let ok=true;
 [[nm,nm.value.trim().length>1],[ph,ph.value.replace(/\D/g,'').length>=10]].forEach(([el,v])=>{el.classList.remove('bad');if(!v){void el.offsetWidth;el.classList.add('bad');ok=false}});
 if(!n){$('#items').animate([{transform:'translateX(-6px)'},{transform:'translateX(6px)'},{transform:'none'}],{duration:300});return}
 const ag=$('#agree');if(!ag.checked){ag.closest('label').animate([{transform:'translateX(-6px)'},{transform:'translateX(6px)'},{transform:'none'}],{duration:300});ok=false}
 if(!ok)return;
 $('#dm').textContent=`${nm.value.trim()}, мы свяжемся с вами по номеру ${ph.value.trim()}, чтобы подтвердить заказ на ${$('#sum').textContent}.`;
 open(false);$('#done').classList.add('on');confetti();cart={};render();e.target.reset()};
$('#ok').onclick=()=>$('#done').classList.remove('on');
function confetti(){const em=['🍬','💗','🍓','🐻','🍊','✨'];
 for(let i=0;i<36;i++){const s=document.createElement('span');s.className='cf';s.textContent=em[i%6];
  s.style.left=Math.random()*100+'vw';s.style.animationDuration=2+Math.random()*2+'s';s.style.animationDelay=Math.random()*.6+'s';
  document.body.append(s);setTimeout(()=>s.remove(),4800)}}

// тема: розовая / голубая (как два логотипа)
const L={pink:'data:image/jpeg;base64,',blue:'data:image/jpeg;base64,'};
function theme(t){document.documentElement.dataset.theme=t==='blue'?'blue':'pink';
 $('#hero-logo').src=L[t];$('#hl').src=L[t];try{localStorage.setItem('su-th',t)}catch(e){}}
let cur='pink';try{cur=localStorage.getItem('su-th')||'pink'}catch(e){}
$('#th').onclick=()=>{cur=cur==='pink'?'blue':'pink';theme(cur)};theme(cur);

// эффекты: параллакс и наклон
const lw=$('#lw'),fl=[...document.querySelectorAll('.fl')];
document.addEventListener('mousemove',e=>{const x=e.clientX/innerWidth-.5,y=e.clientY/innerHeight-.5;
 fl.forEach(f=>{const k=+f.dataset.d;f.style.transform=`translate(${x*k}px,${y*k}px)`})});
document.querySelectorAll('.card').forEach(c=>{
 c.addEventListener('mousemove',e=>{const r=c.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;
  c.style.transform=`perspective(700px) rotateY(${x*10}deg) rotateX(${-y*10}deg) translateY(-6px)`});
 c.addEventListener('mouseleave',()=>c.style.transform='')});
addEventListener('scroll',()=>{fl.forEach((f,i)=>f.style.marginTop=(scrollY*(i%2?.08:-.08))+'px')},{passive:true});
const io=new IntersectionObserver(es=>es.forEach(en=>{if(en.isIntersecting){const el=en.target;
 el.style.transitionDelay=(el.classList.contains('card')?[...el.parentNode.children].indexOf(el)%4*90:0)+'ms';el.classList.add('in');io.unobserve(el)}}),{threshold:.15});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));
render();
</script>
</body>
</html>
