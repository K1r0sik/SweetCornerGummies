<aside id="dr" aria-label="Предзаказ">
  <h2>Ваш предзаказ <button class="ico" id="cl" aria-label="Закрыть">✕</button></h2>
  <div id="items"></div>
  <form id="f" novalidate>
    <input id="nm" placeholder="Ваше имя" autocomplete="name">
    <input id="ph" placeholder="Телефон" inputmode="tel" autocomplete="tel">
